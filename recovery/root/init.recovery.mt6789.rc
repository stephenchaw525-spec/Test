# Infinix X6885 (MT6789) recovery init
# Mirrors the USB setup of the stock recovery (init.recovery.mt6789.rc in vendor_boot).

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 0

on fs
    # MTK musb: cmode 2 = data (SDP) mode, otherwise adb/MTP stay down
    write /sys/class/udc/musb-hdrc/device/cmode 2

# ---- diagnostics only (v6a: fox_clear_bcb DISABLED to test whether it causes the boot loop) ----
# fox_debug.sh : writes diagnostic snapshots to /mnt/vendor/persist/fox_debug/ (readable from Android).
service foxdebug /system/bin/sh /system/bin/fox_debug.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

on boot
    start foxdebug
